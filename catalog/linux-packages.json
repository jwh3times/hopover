{
  "_comment": "Windows app (winget id, or choco:<id>) -> how to install it on Linux. Each entry lists methods; restore-linux.sh uses the first one that works on the running distro, after ranking them by tier (config linux.prefer, default vendor > distro > portable > flatpak). Method kinds: repo (+package: a vendor repo from linux-repos.json), deb/rpm (vendor package URL, or with github: an asset regex), script (vendor installer from linux-repos.json), aur, distro (apt/dnf/pacman names; a string or list installs all, {\"any\": [...]} the first available; keys can also be a distro id like ubuntu or fedora), appimage/tarball (with github: asset regex), flatpak (Flathub id). Options: mayFail (a URL that's fine to be missing for some versions; falls through to the next method), only/except (distro ids, ID_LIKE values, families or bases; id:<x> matches the exact distro id only), tier (override), prereq (list, or per family), post (commands after install), note. Entries can instead be via (install another entry) or none (no Linux version: reason, alternatives). {1} is what the first * of a pattern matched.",

  "windowsOnly": [
    "Microsoft.VCRedist.*", "Microsoft.VCLibs.*", "Microsoft.UI.Xaml.*", "Microsoft.WindowsAppRuntime.*", "Microsoft.DirectX",
    "Microsoft.DotNet.DesktopRuntime.*", "Microsoft.DotNet.Native.*", "Microsoft.DotNet.Framework.*", "Microsoft.WindowsSDK.*", "Microsoft.AppInstaller", "Microsoft.WSL",
    "Microsoft.WebDeploy", "Microsoft.GameInput", "Microsoft.EdgeWebView2Runtime", "Microsoft.PowerToys", "Microsoft.DevHome", "Microsoft.Sysinternals*",
    "Microsoft.XNARedist", "Microsoft.Office.*Runtime*", "Nvidia.PhysX", "Nvidia.GeForceExperience", "Nvidia.NvidiaApp", "AMD.*", "namazso.PawnIO", "Python.Launcher",
    "EpicGames.EpicOnlineServices", "Futuremark.FuturemarkSystemInfo", "Intel.*", "Realtek.*",
    "choco:vcredist*", "choco:KB*", "choco:chocolatey*", "choco:dotnetfx", "choco:dotnet*-runtime", "choco:visualstudio-installer", "choco:*.install"
  ],

  "patterns": [
    { "match": "Microsoft.DotNet.SDK.*",              "use": "dotnet-sdk" },
    { "match": "Microsoft.DotNet.Runtime.*",          "use": "dotnet-runtime" },
    { "match": "Microsoft.DotNet.AspNetCore.*",       "use": "dotnet-aspnetcore" },
    { "match": "Microsoft.OpenJDK.*",                 "use": "msopenjdk" },
    { "match": "Oracle.JDK.*",                        "use": "oracle-jdk" },
    { "match": "EclipseAdoptium.Temurin.*.JDK",       "use": "openjdk" },
    { "match": "Python.Python.3.*",                   "use": "python3" },
    { "match": "Microsoft.VisualStudio.*BuildTools",  "use": "linux:build-tools" },
    { "match": "Microsoft.VisualStudio.20*",          "use": "visual-studio" },
    { "match": "choco:visualstudio*",                 "use": "linux:build-tools" },
    { "match": "choco:python3*",                      "use": "python3" },
    { "match": "JetBrains.*",                         "use": "jetbrains" },
    { "match": "Zoom.Zoom*",                          "use": "zoom" },
    { "match": "TeamViewer.TeamViewer*",              "use": "teamviewer" },
    { "match": "WowUp.Wowup*",                        "use": "wowup" },
    { "match": "GIMP.GIMP*",                          "use": "gimp" }
  ],

