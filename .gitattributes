# Linux scripts must keep LF endings even when checked out on Windows.
*.sh  text eol=lf
*.py  text eol=lf
# cmd.exe misreads a batch file with LF endings (labels, and lines near a 512-byte boundary).
*.cmd text eol=crlf

# `git archive` of a tag writes the tag into lib/version.txt in place of its $Format:...$
# placeholder, so the release zip knows its version (Get-HopoverVersion in lib/Backup.ps1).
/lib/version.txt              export-subst

# Left out of `git archive`, so the hopover-<version>.zip each GitHub Release carries (and GitHub's
# own source archives) hold the tool and its docs, not the development and agent files.
/.agents                      export-ignore
/.claude                      export-ignore
/.github                      export-ignore
/.gitattributes               export-ignore
/.gitignore                   export-ignore
/.nvmrc                       export-ignore
/.python-version              export-ignore
/AGENTS.md                    export-ignore
/CLAUDE.md                    export-ignore
/PSScriptAnalyzerSettings.psd1 export-ignore
/changelog.d                  export-ignore
/docs                         export-ignore
/linux/tests                  export-ignore
/pyproject.toml               export-ignore
/scripts                      export-ignore
/skills-lock.json             export-ignore
/tests                        export-ignore
/uv.lock                      export-ignore
